<!DOCTYPE html>

<html> <head> <title>Registration Page</title> </head> <body>

<h2>User Registration</h2>

<form>
    <label>Full Name:</label><br>
    <input type="text" placeholder="Enter your name" required><br><br>

    <label>Email:</label><br>
    <input type="email" placeholder="Enter your email" required><br><br>

    <label>Password:</label><br>
    <input type="password" placeholder="Enter password" required><br><br>

    <label>Phone Number:</label><br>
    <input type="tel" placeholder="Enter phone number" required><br><br>

    <button type="submit">Register</button>

</form>


</body> </html>
